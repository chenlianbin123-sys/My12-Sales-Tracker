<!--管理员-数据看板页-->
<view class="container">
  <view class="card">
    <view class="header-top">
      <view>
        <text class="title">数据看板</text>
    <view class="muted small" wx:if="{{userName}}" style="margin-top: 8rpx;">
      当前账号：{{userName}}
    </view>
    <view class="muted small" style="margin-top: 4rpx;">
      角色：管理员
    </view>
      </view>
      <button class="btn-refresh" size="mini" bindtap="onRefresh" loading="{{loading}}">
        <text wx:if="{{!loading}}">刷新</text>
        <text wx:else>刷新中...</text>
      </button>
    </view>
    
    <view class="admin-actions">
      <button class="btn-action btn-primary" bindtap="goUsers">
        <text class="btn-icon">👥</text>
        <text class="btn-text">用户管理</text>
        <text class="btn-desc">角色/团队设置</text>
      </button>
      <button class="btn-action btn-primary" bindtap="goProfile">
        <text class="btn-icon">👤</text>
        <text class="btn-text">个人中心</text>
        <text class="btn-desc">账号信息</text>
      </button>
    </view>
  </view>

  <view class="card summary-card" wx:if="{{summary}}">
    <text class="card-title">总体统计</text>
    <view class="summary-row">
      <view class="summary-item">
        <text class="value">{{summary.totalLeads}}</text>
        <text class="label">总线索数</text>
      </view>
      <view class="summary-item">
        <text class="value">{{summary.followUpRate}}%</text>
        <text class="label">已跟进率</text>
      </view>
      <view class="summary-item">
        <text class="value value-won">{{summary.conversionRate}}%</text>
        <text class="label">成交转化率</text>
      </view>
    </view>
    <view class="summary-row" style="margin-top:16rpx;">
      <view class="summary-item">
        <text class="value value-sm value-won">{{summary.statusStats.WON}}</text>
        <text class="label">成交</text>
      </view>
      <view class="summary-item">
        <text class="value value-sm value-lost">{{summary.statusStats.LOST}}</text>
        <text class="label">流失</text>
      </view>
      <view class="summary-item">
        <text class="value value-sm value-warn">{{summary.dueToday}}</text>
        <text class="label">今日待跟进</text>
      </view>
      <view class="summary-item">
        <text class="value value-sm value-danger">{{summary.overdue}}</text>
        <text class="label">已逾期</text>
      </view>
    </view>
    <view class="muted small" style="margin-top:16rpx;">
      共 {{summary.totalFollowUps}} 条跟进记录 · 平均每条线索跟进 {{summary.avgFollowUpCount}} 次
    </view>
    <view class="muted small partial-note" wx:if="{{partial}}">
      数据量已超过单次统计上限（2 万），以上指标为近似值。
    </view>
  </view>

  <view class="card" wx:if="{{salesRanking.length > 0}}">
    <text class="section-title">销售业绩排行（按成交数）</text>
    <view class="rank-row" wx:for="{{salesRanking}}" wx:key="_id">
      <view class="rank-index rank-index-{{index < 3 ? index : 'rest'}}">{{index + 1}}</view>
      <view class="rank-main">
        <view class="row-between">
          <text class="rank-name">{{item.name}}</text>
          <text class="rank-group">第{{item.groupId}}组 · 转化 {{item.conversionRate}}%</text>
        </view>
        <view class="rank-meta">
          分配 {{item.assignedCount}} · 已跟进 {{item.followedCount}} · 跟进 {{item.followUpCount}} 次 · 成交 {{item.wonCount}} · 逾期 {{item.overdueCount}}
        </view>
      </view>
    </view>
  </view>

  <view class="group-stats" wx:if="{{groupStats.length > 0}}">
    <text class="section-title">各团队统计</text>
    <view class="card group-card" wx:for="{{groupStats}}" wx:key="groupId">
      <view class="group-header">
        <text class="group-name">团队 {{item.groupId}}</text>
        <text class="group-members">{{item.anchors}}负责人 + {{item.sales}}成员</text>
      </view>
      <view class="group-summary">
        <view class="stat-item">
          <text class="stat-value">{{item.totalLeads}}</text>
          <text class="stat-label">线索数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{item.followUpRate}}%</text>
          <text class="stat-label">已跟进率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{item.conversionRate}}%</text>
          <text class="stat-label">成交转化</text>
        </view>
        <view class="stat-item">
          <text class="stat-value stat-warn">{{item.overdue}}</text>
          <text class="stat-label">逾期未跟进</text>
        </view>
      </view>
      <view class="status-distribution">
        <text class="dist-label">状态分布：</text>
        <text class="dist-item">待处理 {{item.statusStats.NEW}}</text>
        <text class="dist-item">沟通中 {{item.statusStats.CONTACTED}}</text>
        <text class="dist-item">方案确认 {{item.statusStats.QUOTED}}</text>
        <text class="dist-item">已完成 {{item.statusStats.WON}}</text>
        <text class="dist-item">已关闭 {{item.statusStats.LOST}}</text>
      </view>

      <view class="group-leads">
        <view class="row-between" style="margin-bottom: 16rpx;">
          <text class="leads-title">线索列表（显示最近3条）</text>
          <button class="btn-primary" size="mini" bindtap="goGroupLeads" data-group="{{item.groupId}}">查看全部</button>
        </view>
        <view class="lead-row-wrapper" wx:for="{{item.leads}}" wx:for-item="leadItem" wx:key="_id">
          <view class="lead-row" data-id="{{leadItem._id}}" bindtap="goLeadDetail">
            <view class="lead-main">
              <text class="lead-phone">{{leadItem.customerName || leadItem.phone || '未命名事项'}}</text>
              <text class="lead-status tag-status tag-{{leadItem.lastStatus}}">{{leadItem.lastStatusText}}</text>
            </view>
            <view class="lead-meta">
              <text class="meta-text">分配：{{leadItem.assignedSalesNames || '未分配'}}</text>
              <text class="meta-text" style="margin-left: 12rpx;">跟进：{{leadItem.followUpCount || 0}}次</text>
            </view>
            <view class="lead-meta">
              <text class="meta-text">负责人：{{leadItem.createdBy}}</text>
              <text class="meta-text" style="margin-left: 12rpx;">创建：{{leadItem.createdAtDate || '—'}}</text>
            </view>
            <view class="lead-meta">
              <text class="meta-text">最近：{{leadItem.lastFollowUpDate || '—'}}</text>
              <text class="meta-text" style="margin-left: 12rpx;" wx:if="{{leadItem.nextFollowUpDate}}">下次：{{leadItem.nextFollowUpDate}}</text>
            </view>
          </view>
          <button class="btn-danger-mini" size="mini" data-id="{{leadItem._id}}" bindtap="onDeleteLead">删除</button>
        </view>
        <view class="empty" wx:if="{{item.leads.length === 0}}">
          <text>暂无线索</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<view class="watermark">my12yyds</view>
